# Copy this file to .env and fill in the values you need.
# Nothing here is required — alex works fully offline with Ollama by default.
# Prefer running `alex setup` instead of editing this by hand — it checks what's
# already available, walks you through picking a provider (or a local model sized
# to your hardware), and writes the result here for you.

# ---- Default provider selection --------------------------------------------
ALEX_DEFAULT_PROVIDER=ollama
ALEX_DEFAULT_MODEL=mistral:latest

# ---- Ollama -----------------------------------------------------------------
OLLAMA_ENDPOINT=http://localhost:11434

# ---- OpenAI / OpenAI-compatible ---------------------------------------------
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1

# ---- Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Gemini -------------------------------------------------------------------
GEMINI_API_KEY=

# ---- Groq -----------------------------------------------------------------------
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1

# ---- OpenRouter -----------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1

# ---- LM Studio (or any other local OpenAI-compatible server) -------------------
LMSTUDIO_ENDPOINT=http://localhost:1234/v1

# ---- GitHub (only needed for `alex github` on a private repo) ------------------
GITHUB_TOKEN=

# ---- Web search (optional — only used as an explicit tool during Q&A, never automatically) ----
# Preferred backend: open-websearch (https://github.com/Aas-ee/open-webSearch) — free, self-hosted,
# no API key. If OPEN_WEBSEARCH_ENDPOINT isn't reachable and OPEN_WEBSEARCH_AUTOSTART is on (default),
# alex will offer to install and start it itself with `npx -y open-websearch@latest` the first time
# a question actually needs it (requires Node.js — nothing is installed without asking first).
# Leave OPEN_WEBSEARCH_ENDPOINT blank to use OPEN_WEBSEARCH_PORT (default 3000) on localhost.
OPEN_WEBSEARCH_ENDPOINT=
OPEN_WEBSEARCH_PORT=3000
OPEN_WEBSEARCH_AUTOSTART=true

# Fallback backend: Tavily (https://tavily.com) — hosted, requires an API key. Used only if
# open-websearch isn't reachable and can't be started.
TAVILY_API_KEY=

# ---- Paths ----------------------------------------------------------------------
ALEX_CACHE_DIR=.alex/cache
ALEX_DB_PATH=.alex/memory.sqlite3
ALEX_VECTOR_DIR=.alex/vectors
ALEX_DOCS_DIR=docs
ALEX_LOG_LEVEL=INFO
