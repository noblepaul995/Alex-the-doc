# Copy this file to .env and fill in the values you need.
# Nothing here is required — alex works fully offline with Ollama by default.

# ---- Default provider selection --------------------------------------------
ALEX_DEFAULT_PROVIDER=ollama
ALEX_DEFAULT_MODEL=mistral:latest

# ---- Ollama -----------------------------------------------------------------
OLLAMA_ENDPOINT=http://localhost:11434

# ---- OpenAI / OpenAI-compatible ---------------------------------------------
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://api.openai.com/v1

# ---- Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Gemini -------------------------------------------------------------------
GEMINI_API_KEY=

# ---- Groq -----------------------------------------------------------------------
GROQ_API_KEY=
GROQ_ENDPOINT=https://api.groq.com/openai/v1

# ---- OpenRouter -----------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1

# ---- LM Studio (or any other local OpenAI-compatible server) -------------------
LMSTUDIO_ENDPOINT=http://localhost:1234/v1

# ---- Paths ----------------------------------------------------------------------
ALEX_CACHE_DIR=.alex/cache
ALEX_DB_PATH=.alex/memory.sqlite3
ALEX_VECTOR_DIR=.alex/vectors
ALEX_DOCS_DIR=docs
ALEX_LOG_LEVEL=INFO
